# Copy to .env and adjust. Only POSTGRES_PASSWORD is required.

# Host port the web UI is served on. It is bound to 127.0.0.1 only: reach it
# through the Cloudflare tunnel (or http://localhost:<PORT> on this machine).
PORT=8080

# Path (inside the backend container) to a Netscape cookies.txt exported from a
# logged-in YouTube session. Only needed if extraction hits bot checks.
# Put the file in ./config/cookies.txt and set:
# YTDLP_COOKIES=/config/cookies.txt

# --- Authentication / session ---
# These are read by the backend; the values below are the docker-compose.yml
# defaults, repeated here for reference. Override in .env only if you need to.
#
# LOCAL PLAIN-HTTP OVERRIDE: the defaults below use the __Host- cookie prefix
# with Secure=true. That is correct for any HTTPS deployment (a Cloudflare
# tunnel included), but a browser REJECTS such a cookie over plain http://
# (anything that is not HTTPS and not bare localhost), so login silently
# fails. For local access over plain HTTP set:
#   SESSION_COOKIE_NAME=resonar_session
#   SESSION_COOKIE_SECURE=false
# Keep the __Host- name and SESSION_COOKIE_SECURE=true for every HTTPS
# deployment.

# --- Database (Postgres) ---
# Read by docker-compose.yml to configure the `db` service and build the
# backend's DATABASE_URL. POSTGRES_PASSWORD is REQUIRED (compose refuses to
# start without it) — generate one with: openssl rand -hex 24
# It only takes effect when the db-data volume is first created; see
# docs/OPERATIONS.md to rotate it later.
# Override these (not DATABASE_URL) if you use docker compose.
# POSTGRES_USER=resonar
POSTGRES_PASSWORD=
# POSTGRES_DB=resonar

# SQLAlchemy URL for the Postgres database (psycopg 3, sync). Only read
# directly by the backend when NOT using docker compose (e.g. `uvicorn`
# locally); under docker compose it's built from the POSTGRES_* vars above.
DATABASE_URL=postgresql+psycopg://resonar:resonar@db:5432/resonar

# Comma-separated allowed CORS origins. Empty by default: cookie auth is
# incompatible with "*", and prod (nginx) / dev (Vite proxy) are same-origin.
CORS_ORIGINS=

# Session cookie name. __Host- prefix requires Secure + Path=/ + no Domain.
SESSION_COOKIE_NAME=__Host-resonar_session

# Send the session cookie only over HTTPS. Set false for local plain-HTTP dev.
SESSION_COOKIE_SECURE=true

# Normal session: idle timeout and absolute cap, in seconds (12h / 7d).
SESSION_IDLE_TTL=43200
SESSION_ABSOLUTE_TTL=604800

# "Remember me" session: idle timeout and absolute cap, in seconds (30d / 90d).
SESSION_REMEMBER_IDLE_TTL=2592000
SESSION_REMEMBER_ABSOLUTE_TTL=7776000

# Optional shared secret required by POST /api/auth/bootstrap (the one-time
# superadmin creation). Leave unset to allow bootstrap without a token.
# BOOTSTRAP_TOKEN=
